// Cloudflare Worker config: static site from ./public plus a small score API (src/worker.js, D1).
// Cloudflare runs `npx wrangler deploy` on every push to main; the D1 database is created on first deploy.
{
  "name": "tinsel-patrol",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "tinsel-patrol-scores" }
  ],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "tinselpatrol.com", "custom_domain": true },
    { "pattern": "www.tinselpatrol.com", "custom_domain": true }
  ]
}
