{
  "name": "tinsel-patrol",
  "version": "1.0.0",
  "private": true,
  "description": "Tinsel Patrol: defend the Christmas tree from cats. Web build in public/, iOS app via Capacitor.",
  "scripts": {
    "build:web": "python3 build.py",
    "build:www": "node scripts/prepare-www.mjs",
    "sync:ios": "npm run build:www && cap sync ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2"
  }
}
